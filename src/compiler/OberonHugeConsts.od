DEFINITION OberonHugeConsts;

   (* folding of 64-bit integer constants (HUGEINT)

      The compiler holds integer constants in 32 bits (intval); a constant
      beyond that range keeps its low word in intval and its high word in
      setval (setval = {} for all other constants).  The values between
      2^31 and 2^32-1 cannot be represented this way; Join fails for them
      and the expression is left to run time.
   *)

   TYPE
      Value = RECORD lo, hi: LONGINT END;

   PROCEDURE Split(intval: LONGINT; setval: SET; VAR value: Value);
   PROCEDURE Join(value: Value; VAR intval: LONGINT; VAR setval: SET) : BOOLEAN;
      (* FALSE if value cannot be represented *)

   PROCEDURE Add(a, b: Value; VAR sum: Value) : BOOLEAN;
   PROCEDURE Sub(a, b: Value; VAR diff: Value) : BOOLEAN;
   PROCEDURE Neg(a: Value; VAR neg: Value) : BOOLEAN;
      (* FALSE on overflow *)

   PROCEDURE Compare(a, b: Value) : INTEGER;
      (* < 0, = 0, > 0 if a < b, a = b, a > b *)

END OberonHugeConsts.
