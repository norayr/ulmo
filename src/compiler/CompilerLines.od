DEFINITION CompilerLines;

   (* line numbers of source positions, e.g. for run time error messages *)

   IMPORT CompilerObjects, Streams;

   PROCEDURE Line(loc: CompilerObjects.Location;
                  pos: Streams.Count) : Streams.Count;
      (* number of the line (counting from 1) that contains the position
	 pos of the source of loc; 0 if it cannot be determined
      *)

END CompilerLines.
