DEFINITION AMD64LinuxOberonBuiltIns; (* Christian Ehrhardt, AMD64 adaptation *)

   IMPORT Emit := AMD64Emit, Operands := AMD64Operands,
      PC := AMD64OberonContexts, Regs := CompilerRegisters,
      Sym := OberonSymbols;

   PROCEDURE GenBuiltIn(proc: PC.Context; at: Sym.Attribute;
                        possible: SET; caller: Regs.Owner) : Operands.Operand;


END AMD64LinuxOberonBuiltIns.
