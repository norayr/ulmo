MODULE AMD64OberonBuiltIns;

   (* defines AMD64 specific extensions of SYSTEM for access to registers *)

   IMPORT Args, OberonBuiltIns, Procs := AMD64OberonProcedures, Scopes,
      Sym := OberonSymbols, Types := OberonBaseTypes;

   PROCEDURE Add(scope: Scopes.Scope; args: Args.Arguments);
      (* insert all standard constants, types, procedures and functions
	 into scope in dependence of args
      *)

      PROCEDURE AddIdent(ident: Sym.Ident);
      BEGIN
	 OberonBuiltIns.AddIdent(scope, ident, args, "amd64sys");
      END AddIdent;

   BEGIN (* Add *)
      AddIdent(Procs.sqrtF);
      AddIdent(Procs.sinF);
      AddIdent(Procs.cosF);
   END Add;

   PROCEDURE Init;
      VAR
	 if: OberonBuiltIns.Interface;
   BEGIN
      NEW(if); if.add := Add; if.defArgs := NIL;
      OberonBuiltIns.RegisterSet("amd64sys", if);
   END Init;

BEGIN
   Init;
END AMD64OberonBuiltIns.
