(* Ulm's Oberon Library
   AMD64 variant: AuxParameterRec uses SYS.ADDRESS for both fields to match
   Elf64_auxv_t (two 64-bit words per entry).
*)

MODULE SysArgs;

   IMPORT SYS := SYSTEM;

   (* interface to UNIX command line arguments *)

   CONST
      kb = 1024;
      large = 32 * kb;

   TYPE
      (* $P- $O- don't trace any pointers here *)
      ArgumentA = ARRAY large OF CHAR;
      Argument = POINTER TO ArgumentA;
	 (* arguments may be accessed elementwise only;
	    every argument is 0X-terminated
	 *)
      ArgumentsA = ARRAY large OF Argument;
      Arguments = POINTER TO ArgumentsA;
	 (* elementwise access only;
	    array is NIL-terminated
	 *)
      AuxParameterRec =
	 RECORD
	    type: SYS.ADDRESS;   (* Elf64_auxv_t.a_type *)
	    value: SYS.ADDRESS;  (* Elf64_auxv_t.a_val  *)
	 END;
      AuxiliaryParameters = POINTER TO ARRAY large OF AuxParameterRec;
      (* $P= $O= *)

   VAR
      (* command line arguments; must not be modified; argv may be NIL *)
      argc: INTEGER;		(* number of arguments *)
      argv: Arguments;		(* argv[0] .. argv[argc-1] are valid *)

      (* environ parameters; environ may be NIL;
	 `environ' may be modified but not the original environment list
      *)
      envc: INTEGER;		(* number of environment parameters *)
      environ: Arguments;	(* environ[0] .. environ[envc-1] are valid *)

      auxc: INTEGER;            (* number of auxiliary parameters *)
      auxv: AuxiliaryParameters; (* auxv^[0] .. auxv^[auxc-1] are valid *)

   PROCEDURE GetCommandName(VAR name: ARRAY OF CHAR);
      VAR index, slash, dest: LONGINT;
   BEGIN
      IF LEN(name) = 0 THEN RETURN END;
      name[0] := 0X;
      IF (argc > 0) & (argv # NIL) THEN
         slash := -1; index := 0;
         WHILE argv[0][index] # 0X DO
            IF argv[0][index] = "/" THEN slash := index END;
            INC(index);
         END;
         index := slash + 1; dest := 0;
         WHILE (dest + 1 < LEN(name)) & (argv[0][index] # 0X) DO
            name[dest] := argv[0][index]; INC(index); INC(dest);
         END;
         name[dest] := 0X;
      END;
   END GetCommandName;

   PROCEDURE GetPathName(VAR path: ARRAY OF CHAR);
      VAR index: LONGINT;
   BEGIN
      IF LEN(path) = 0 THEN RETURN END;
      index := 0;
      IF (argc > 0) & (argv # NIL) THEN
         WHILE (index + 1 < LEN(path)) & (argv[0][index] # 0X) DO
            path[index] := argv[0][index]; INC(index);
         END;
      END;
      path[index] := 0X;
   END GetPathName;

BEGIN
   (* argc, argv, and environ are initialized by the run time system *)
   envc := 0;
   IF environ # NIL THEN
      WHILE environ[envc] # NIL DO
	 INC(envc);
      END;
   END;

   auxc := 0;
   IF auxv # NIL THEN
      WHILE auxv[auxc].type # 0 DO
	 INC(auxc);
      END;
   END;
END SysArgs.
