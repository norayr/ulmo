(* AMD64 SysSegments: 8-byte address/size fields matching SysStorage's types.
   All segments are recorded, including the high-address main stack;
   SysStorage.Init filters out addresses Memory cannot model with its own
   64-bit range check. *)
MODULE SysSegments;

   IMPORT SYS := SYSTEM;

   CONST
      maxsegments = 128;

   TYPE
      Address = SYS.UNTRACEDADDRESS;
      Size = SYS.UNTRACEDADDRESS;
      Mode = SHORTINT;
      Segment =
	 RECORD
	    addr: Address;
	    size: Size;
	    mode: Mode;
	 END;
   VAR
      segments: ARRAY maxsegments OF Segment;
      nextslot: INTEGER;

   PROCEDURE PanicExit;
   BEGIN
      HALT(255); LOOP END;
   END PanicExit;

   PROCEDURE Register(addr: Address; size: Size; mode: Mode);
   BEGIN
      IF nextslot = maxsegments THEN PanicExit END;
      segments[nextslot].addr := addr;
      segments[nextslot].size := size;
      segments[nextslot].mode := mode;
      INC(nextslot);
   END Register;

   PROCEDURE NumberOfSegments() : INTEGER;
   BEGIN
      RETURN nextslot
   END NumberOfSegments;

   PROCEDURE GetSegment(segmentIndex: INTEGER; VAR segment: Segment);
   BEGIN
      IF (segmentIndex >= 0) & (segmentIndex < nextslot) THEN
	 segment := segments[segmentIndex];
      ELSE
	 PanicExit;
      END;
   END GetSegment;

BEGIN
   nextslot := 0;
END SysSegments.
